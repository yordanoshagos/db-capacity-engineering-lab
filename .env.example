# Copy to .env and `set -a; source .env; set +a`. Never commit .env.

LOCALSTACK_AUTH_TOKEN=
AIVEN_HOST=
AIVEN_PORT=
AIVEN_USER=avnadmin
AIVEN_PASSWORD=
AIVEN_DB=capacity_lab
AIVEN_CA_PATH=./secrets/aiven-ca.pem

# Optional: Alertmanager posts firing alerts here. Incoming Webhook URL from Slack.
# Never commit the real URL.
SLACK_WEBHOOK_URL=
